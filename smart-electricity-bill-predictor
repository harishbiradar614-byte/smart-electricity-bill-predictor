import java.io.*;
import java.util.*;

class Record {
    String month;
    int units;
    double bill;

    Record(String month, int units, double bill) {
        this.month = month;
        this.units = units;
        this.bill = bill;
    }
}

public class SmartElectricityBillPredictor {

    static ArrayList<Record> records = new ArrayList<>();
    static final String FILE_NAME = "bill.txt";
    static Scanner sc = new Scanner(System.in);

    public static void main(String[] args) {
        loadData();

        while (true) {
            System.out.println("\n===== SMART ELECTRICITY BILL PREDICTOR =====");
            System.out.println("1. Add Monthly Record");
            System.out.println("2. View Bill History");
            System.out.println("3. Predict Next Month Bill");
            System.out.println("4. Exit");
            System.out.print("Enter choice: ");

            int choice = sc.nextInt();
            sc.nextLine();

            switch (choice) {
                case 1:
                    addRecord();
                    break;
                case 2:
                    viewHistory();
                    break;
                case 3:
                    predictBill();
                    break;
                case 4:
                    saveData();
                    System.out.println("Data saved successfully.");
                    return;
                default:
                    System.out.println("Invalid Choice!");
            }
        }
    }

    static void addRecord() {
        System.out.print("Enter Month: ");
        String month = sc.nextLine();

        System.out.print("Enter Units Consumed: ");
        int units = sc.nextInt();

        double bill = calculateBill(units);

        records.add(new Record(month, units, bill));

        System.out.println("Bill Amount = Rs. " + bill);
    }

    static double calculateBill(int units) {
        double bill;

        if (units <= 100)
            bill = units * 3;
        else if (units <= 200)
            bill = (100 * 3) + (units - 100) * 5;
        else
            bill = (100 * 3) + (100 * 5) + (units - 200) * 7;

        return bill;
    }

    static void viewHistory() {
        if (records.isEmpty()) {
            System.out.println("No records found.");
            return;
        }

        System.out.println("\nMonth\tUnits\tBill");
        for (Record r : records) {
            System.out.println(r.month + "\t" + r.units + "\tRs." + r.bill);
        }
    }

    static void predictBill() {
        if (records.size() < 3) {
            System.out.println("Enter at least 3 months data.");
            return;
        }

        int n = records.size();

        int avgUnits = (records.get(n - 1).units +
                        records.get(n - 2).units +
                        records.get(n - 3).units) / 3;

        double predictedBill = calculateBill(avgUnits);

        System.out.println("\nPredicted Units : " + avgUnits);
        System.out.println("Estimated Bill  : Rs. " + predictedBill);

        if (avgUnits > 200)
            System.out.println("Suggestion: Reduce AC and heater usage.");
        else if (avgUnits > 100)
            System.out.println("Suggestion: Use LED bulbs to save energy.");
        else
            System.out.println("Excellent! Your consumption is low.");
    }

    static void saveData() {
        try {
            PrintWriter pw = new PrintWriter(new FileWriter(FILE_NAME));

            for (Record r : records) {
                pw.println(r.month + "," + r.units + "," + r.bill);
            }

            pw.close();

        } catch (Exception e) {
            System.out.println("Error saving file.");
        }
    }

    static void loadData() {
        try {
            File file = new File(FILE_NAME);

            if (!file.exists())
                return;

            Scanner fs = new Scanner(file);

            while (fs.hasNextLine()) {
                String line = fs.nextLine();
                String[] data = line.split(",");

                records.add(new Record(
                        data[0],
                        Integer.parseInt(data[1]),
                        Double.parseDouble(data[2])
                ));
            }

            fs.close();

        } catch (Exception e) {
            System.out.println("Error loading file.");
        }
    }
}
